# ===== JYCloud 前端控制台环境配置模板 =====
# 复制本文件为 .env 或 .env.<环境> 后按需修改；真实环境文件不入库

# 打包路径
VITE_BASE_URL=/

# 是否启用 Vite 代理（true 时 VITE_API_URL 不生效，请求由开发服务器转发）
VITE_IS_REQUEST_PROXY=true

# 接口地址：直连后端时填写，走代理时留空
VITE_API_URL=

# 接口前缀：请求拼接为 /api/jy-user/**
VITE_API_URL_PREFIX=/api

# 网关地址：本地开发代理目标
VITE_GATEWAY=http://localhost:9000

# 默认应用 clientId（初始登录与兜底，默认进入用户中心）
VITE_CLIENT_ID=jy-ucenter

# 应用标题
VITE_APP_TITLE=JYCloud 前端控制台