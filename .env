# ===== JYCloud 前端基础框架环境配置 =====
# 打包路径
VITE_BASE_URL=/
# 是否走 Vite 代理（true 时 VITE_API_URL 不生效，请求由开发服务器转发）
VITE_IS_REQUEST_PROXY=true
# 接口地址：直连后端时填写，走代理时留空
VITE_API_URL=
# 接口前缀：请求拼接为 /api/jy-user/**
VITE_API_URL_PREFIX=/api
# 网关地址：本地开发代理目标
VITE_GATEWAY=http://localhost:9000
# 当前应用客户端 ID（登录与菜单权限使用，如 jy-setting / jy-ucenter）
VITE_CLIENT_ID=1111
# 应用标题
VITE_APP_TITLE=JYCloud 基础框架
